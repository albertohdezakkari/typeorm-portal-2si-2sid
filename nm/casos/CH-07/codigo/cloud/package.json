{
  "name": "taller-serverless",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "deploy": "node ./node_modules/serverless/bin/serverless.js deploy",
    "info": "node ./node_modules/serverless/bin/serverless.js info",
    "invoke": "node ./node_modules/serverless/bin/serverless.js invoke",
    "package": "node ./node_modules/serverless/bin/serverless.js package"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1169.0",
    "@aws-sdk/lib-dynamodb": "3.1169.0",
    "dynamodb-toolbox": "2.11.1"
  },
  "devDependencies": {
    "serverless": "3.40.0"
  }
}
